# Agent-flow reads whichever keys you have. Native keys beat OpenRouter
# (no markup). xAI is the default coding stack; other vendors are used
# when they are stronger for a role (review, UI, bulk, terminal).

# SpaceXAI / xAI  —  required for the default stack
# https://console.x.ai
XAI_API_KEY=

# Cross-vendor review + long-horizon reasoning
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Terminal-heavy / Codex-class work
# https://platform.openai.com
OPENAI_API_KEY=

# UI / visual / multimodal design
# https://aistudio.google.com
GEMINI_API_KEY=

# Bulk / budget implementation
# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot / Kimi  —  OpenAI-compatible
# https://platform.moonshot.cn  (intl: set MOONSHOT_BASE_URL=https://api.moonshot.ai/v1)
MOONSHOT_API_KEY=
# KIMI_API_KEY=          # alias for MOONSHOT_API_KEY

# Alibaba / Qwen  —  DashScope OpenAI-compatible
# https://bailian.console.aliyun.com  (CN default)
# DASHSCOPE_REGION=cn|intl|us   or DASHSCOPE_BASE_URL=https://...
DASHSCOPE_API_KEY=
# QWEN_API_KEY=          # alias for DASHSCOPE_API_KEY

# Local OpenAI-compatible inference (no hosted API token charge)
# Install Ollama, pull a model, then set its exact local name.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional fallback for any model whose native key is missing
# https://openrouter.ai
OPENROUTER_API_KEY=

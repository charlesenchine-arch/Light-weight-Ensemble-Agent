# LEA reads whichever provider keys you have. Native keys are preferred.

# https://console.x.ai
XAI_API_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# https://platform.openai.com
OPENAI_API_KEY=

# https://aistudio.google.com
GEMINI_API_KEY=

# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot / Kimi (KIMI_API_KEY is also accepted)
MOONSHOT_API_KEY=

# Alibaba / Qwen (QWEN_API_KEY is also accepted)
DASHSCOPE_API_KEY=

# Local inference through Ollama (for example: qwen3-coder:30b)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional fallback transport
OPENROUTER_API_KEY=
